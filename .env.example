# Copy to .env (git-ignored). NEVER commit real values.

# Client-safe (publishable/anon key only; protected by RLS)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SERVER-ONLY: set via `supabase secrets set`, never in Android or in git
GEMINI_API_KEY=
GEMINI_MODEL=

# GitHub Actions secrets (Settings > Secrets), not files:
# ANDROID_KEYSTORE_BASE64
# ANDROID_KEYSTORE_PASSWORD
# ANDROID_KEY_ALIAS
# ANDROID_KEY_PASSWORD
