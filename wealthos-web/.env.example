# WealthOS Web — Environment Variables
# Copy this to .env and fill in your Supabase anon key from GitHub secrets

VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# The Supabase URL is hardcoded in lib/supabase.ts (public, safe)
# All other secrets (GEMINI_API_KEY, service_role_key) stay in Supabase Edge Function secrets
